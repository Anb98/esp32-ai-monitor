# Host directory containing your Claude Code credential files
# (~/.claude, ~/.claude.json). docker-compose mounts this
# read-only into the container at fixed Linux paths regardless of host OS.
#
# Windows (PowerShell):  HOST_HOME=C:\Users\<you>
# Linux / macOS:         HOST_HOME=/home/<you>   (or: echo $HOME)
#
# Copy this file to .env and set HOST_HOME before running docker compose up.
HOST_HOME=

# IANA timezone used to format reset_time (e.g. America/Guatemala, Europe/Madrid).
# Defaults to UTC when unset, which offsets every clock the firmware shows.
TZ=
