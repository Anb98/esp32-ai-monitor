; Copy this file to secrets.ini (git-ignored) and fill in your credentials.
; Keep the [secrets] section name: platformio.ini interpolates
; ${secrets.build_flags} into its own build_flags so these defines are
; APPENDED. Declaring an [env:...] section here instead would replace the
; environment's whole build_flags and silently drop the PSRAM and LVGL flags.
[secrets]
build_flags =
    -D WIFI_SSID=\"YourWiFiSSID\"
    -D WIFI_PASS=\"YourWiFiPassword\"
    -D DASHBOARD_URL=\"http://192.168.1.100:8080/api/dashboard\"
